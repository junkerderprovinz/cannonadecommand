<?php
/* Loads the Docker-tab enhancer on the container add/edit form and its run output. Community
   Applications opens the same form at /Apps/AddContainer (CreateDocker.php branches on "/Apps/"),
   and the Menu="Docker" hook never loads on these Title-only pages because DefaultPageLayout
   merges Menu hooks only for Type=xmenu parents. This Buttons hook runs on every page but emits
   its assets only on the form URLs; docker.js detects the form (onCtForm) and boots its light
   form mode without polling. Link="..." keeps the nav bar free of an icon. */
$ccReq = strtok($_SERVER['REQUEST_URI'] ?? '', '?');
if (preg_match('#^/(Docker|Apps)/(AddContainer|UpdateContainer)/?$#', $ccReq)):
?>
<link type="text/css" rel="stylesheet" href="<?autov('/plugins/cannonadecommand/styles/docker.css')?>">
<script defer src="<?autov('/plugins/cannonadecommand/scripts/docker.js')?>"></script>
<?php endif; ?>
