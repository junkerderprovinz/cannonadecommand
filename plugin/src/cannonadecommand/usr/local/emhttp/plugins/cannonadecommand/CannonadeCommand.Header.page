<?php
/* Registered under Menu="Buttons" so Unraid loads this page's assets into the <head> of every
   page: sheets/CannonadeCommand.Header.css (auto-injected because the basename matches this
   .page) restyles the main menu bar, and the script below loads the header enhancer.
   Link="cc-hdr-hook" makes Navigation render a bare <div> instead of a visible icon. All styling
   is gated behind html.cc-header-on, which the enhancer sets only when the main menu bar area
   is enabled in CC settings. */
?>
<!-- header.js loads deferred, so on its own the page would paint natively first and then snap to
     the CC look. This inline script stamps the same gating classes header.js apply() sets, read
     straight from localStorage, so the CC CSS applies from the first paint. It only adds classes,
     so a failure falls back to the flash rather than a blank page; apply() re-stamps them later. -->
<script>
(function () {
  try {
    var r = document.documentElement;
    function g(k, d) { try { var v = localStorage.getItem(k); return v == null ? d : v; } catch (e) { return d; } }
    var theming = g("cc.theming", "1") !== "0";
    var on = g("cc.enable.header", "0") !== "0" && theming;
    r.classList.toggle("cc-header-on", on);
    r.classList.toggle("cc-shape-circle", g("cc.badgeshape", "pill") === "circle");
    r.classList.toggle("cc-badge-glass", g("cc.badgeglass", "0") === "1" && theming);
    r.classList.toggle("cc-popups-on", theming);
    r.classList.toggle("cc-footer-off", g("cc.footer", "1") === "1" && theming);
    r.classList.toggle("cc-hide-favtab", g("cc.hidefavtab", "0") === "1" && theming);
    r.classList.toggle("cc-usage-isl", on && g("cc.island", "1") !== "0");
    // The reactive rainbow classes use the same condition as apply(); without them every
    // reactive-mode badge shows its accent colour until the deferred header.js lands.
    var react = theming && g("cc.rbmode", "all") === "active";
    r.classList.toggle("cc-header-rbneutral", react && on);
    r.classList.toggle("cc-apps-rbneutral", react && /^\/Apps(\/|$)/.test(location.pathname));
    r.classList.toggle("cc-shares-rbneutral", react);
    r.classList.toggle("cc-settingsgrid-rbneutral", react);
  } catch (e) {}
})();
</script>
<script defer src="<?autov('/plugins/cannonadecommand/scripts/header.js')?>"></script>
